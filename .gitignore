# ==========================================================
# Big-Tech Standard .gitignore for Go, Docker, & IDEs
# ==========================================================

# 1. Binaries and Executables
# ---------------------------
# Go compiled binaries
/main
/server
/app
# Common executable/binary formats
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
out/

# 2. Secret & Configuration Files
# -------------------------------
# Sensitive credentials must never be committed
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.p12
credentials.json
jwt_secret*

# 3. Go Tooling and Packages
# --------------------------
# Go workspace configurations
go.work
go.work.sum
# Go test outputs and profiles
*.coverprofile
*.out
*.test
*.prof
# Dependency vendor directory (optional, modern Go uses go.mod cache)
vendor/

# 4. Docker & Local Containers
# ----------------------------
# Ignore docker overrides and database initializations
docker-compose.override.yml
.docker/
init.sql
scripts/*/init.sql

# 5. IDE and Editor Directories
# -----------------------------
# JetBrains (GoLand, IntelliJ, WebStorm, etc.)
.idea/
*.iml
*.iws
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
# Vim / Emacs
*~
*.swp
*.swo
.netrwhist

# 6. Operating System Specific
# ----------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# 7. Logs and Temporary Data
# --------------------------
*.log
/tmp/
/temp/
